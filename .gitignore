# Rust build outputs
/target/
**/*.rs.bk

# Rust/Cargo diagnostics and profiling artifacts
*.profraw
*.profdata
*.dSYM/

# 本地一次性分析产物(AI agent 工作稿等)
/artifacts/

# Web UI 的 wasm 产物由 `scripts/build.sh` 生成
/crates/astrcode-webui/www/wasm/

# Python (sdks/python)
__pycache__/
*.py[cod]
*.egg-info/
/sdks/python/dist/
/sdks/python/build/
/sdks/python/.venv/
/sdks/python/.pytest_cache/
/sdks/python/.mypy_cache/
/sdks/python/.ruff_cache/
# Local environment files
.env
.env.*
!.env.example

# Editor and IDE state
.idea/
.vscode/
*.code-workspace

# OS-generated files
.DS_Store
Thumbs.db
Desktop.ini

# Patch / merge leftovers
*.orig
*.rej

# Temporary files
*.log
*.tmp
*.temp

# Local agent runtime state
/.omx/logs/
/.omx/state/
/.astrcode/
.ralph/
**/.astrcode/

.claude/
.codex/
.agents/

target/

plugins/

/.consult/
